rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.email == 'moreand458@gmail.com' && request.auth.token.email_verified == true; }

    function validProfile(d) {
      return d.keys().hasOnly(['name','bio','photoURL','updatedAt'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 40
        && d.bio is string && d.bio.size() <= 200
        && d.photoURL is string && d.photoURL.size() <= 60000
        && d.updatedAt is timestamp;
    }
    function validReview(d, appId, uid) {
      return d.keys().hasOnly(['appId','uid','rating','text','name','photoURL','createdAt','updatedAt'])
        && d.appId == appId && d.uid == uid
        && d.rating is int && d.rating >= 1 && d.rating <= 5
        && d.text is string && d.text.size() <= 500
        && d.name is string && d.name.size() <= 40
        && d.photoURL is string && d.photoURL.size() <= 60000
        && d.createdAt is timestamp && d.updatedAt is timestamp;
    }

    match /apps/{appId} {
      allow read: if true;
      allow create, delete: if admin();
      allow update: if admin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloads','updatedAt']) &&
        request.resource.data.downloads == resource.data.downloads + 1
      );

      match /shots/{sid} {
        allow read: if true;
        allow write: if admin();
      }

      match /reviews/{uid} {
        allow read: if true;
        allow create: if signedIn() && request.auth.uid == uid && validReview(request.resource.data, appId, uid);
        allow update: if signedIn() && request.auth.uid == uid && validReview(request.resource.data, appId, uid)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if signedIn() && (request.auth.uid == uid || admin());
      }
    }

    // قراءة كل التقييمات (لحساب المتوسطات في الصفحة الرئيسية)
    match /{path=**}/reviews/{reviewId} {
      allow read: if true;
    }

    match /profiles/{userId} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == userId && validProfile(request.resource.data);
      allow delete: if admin();
    }

    match /notifications/{nid} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    match /settings/{sid} {
      allow read: if true;
      allow write: if admin();
    }

    match /users/{userId} {
      allow read: if admin();
      allow create, update: if signedIn() && request.auth.uid == userId;
    }
    match /stats/{statId} {
      allow read: if true;
      allow create: if statId == 'global' && request.resource.data.visitors == 1;
      allow update: if statId == 'global' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visitors','updatedAt']) && request.resource.data.visitors == resource.data.visitors + 1;
      allow delete: if admin();
    }
  }
}
